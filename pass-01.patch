+<!doctype html>
+<html data-skin="signal" lang="en" data-theme="dark">
+<head>
+  <meta charset="utf-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1" />
+  <meta name="description" content="The six-day Wormhole sequence — synchronized identity install." />
+  <title>Wormhole · The Protocol</title>
+  <link rel="stylesheet" href="wormhole-dark.css" />
+  <link rel="stylesheet" href="wormhole-light.css" />
+<script>(function(){try{var t=localStorage.getItem("the-protocol.theme");if(t==="dark"||t==="light"){document.documentElement.setAttribute("data-theme",t);}}catch(e){}})();</script></head>
+<body>
+<header class="site-header">
+  <div class="site-header__inner">
+    <a class="brand" href="index.html">The Protocol</a>
+    <nav class="site-nav" aria-label="Primary navigation">
+      <a href="overview.html" class="">Overview</a>
+      <a href="index.html" class="">Daily Run</a>
+      <a href="levels.html" class="">Levels</a>
+      <a href="wormhole.html" class="is-active">Wormhole</a>
+      <a href="age-reversal.html" class="">Age Reversal</a>
+      <a href="custom.html" class="">Custom</a>
+      <a href="bank.html" class="">Bank</a>
+    </nav>
+    <div class="header-actions">
+      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle theme">☼</button>
+      <button class="mobile-menu-toggle" type="button" data-mobile-menu-toggle aria-expanded="false" aria-label="Open menu">Menu</button>
+    </div>
+  </div>
+  <nav class="mobile-nav" data-mobile-nav aria-label="Mobile navigation">
+    <a href="overview.html" class="">Overview</a>
+    <a href="index.html" class="">Daily Run</a>
