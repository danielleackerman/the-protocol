+  font-weight: 850;
+  letter-spacing: .05em;
+  line-height: 1.15;
+  text-transform: uppercase;
+  background: var(--wh-off-bg);
+  border: 1px solid var(--wh-off-border);
+  box-shadow: var(--wh-off-shadow);
+}
