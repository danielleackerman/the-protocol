@@ -1283,6 +1290,28 @@ html[data-skin="signal"] .command-token--on {
   box-shadow: none;
 }
 
+/* Semantic state — deactivated states. The OFF/DELETED analogue of
+   .state-on: a flat clay chip so a switch turned off reads as off at a
