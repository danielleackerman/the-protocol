@@ -0,0 +1,74 @@
+<!doctype html>
+<html data-skin="signal" lang="en" data-theme="dark">
+<head>
+  <meta charset="utf-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1" />
+  <meta name="description" content="Sequences — standalone runs and multi-day installs. Each one installs a specific file." />
+  <title>Sequences · The Protocol</title>
+  <link rel="stylesheet" href="wormhole-dark.css" />
+  <link rel="stylesheet" href="wormhole-light.css" />
+<script>(function(){try{var t=localStorage.getItem("the-protocol.theme");if(t==="dark"||t==="light"){document.documentElement.setAttribute("data-theme",t);}}catch(e){}})();</script></head>
+<body>
+<header class="site-header">
+  <div class="site-header__inner">
+    <a class="brand" href="index.html">The Protocol</a>
+    <nav class="site-nav" aria-label="Primary navigation">
+      <a href="overview.html">Overview</a>
+      <a href="index.html">Daily Run</a>
+      <a href="levels.html">Levels</a>
+      <a href="sequences.html" class="is-active">Sequences</a>
+      <a href="custom.html">Custom</a>
+      <a href="bank.html">Bank</a>
+    </nav>
+    <div class="header-actions">
+      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle theme">☼</button>
+      <button class="mobile-menu-toggle" type="button" data-mobile-menu-toggle aria-expanded="false" aria-label="Open menu">Menu</button>
+    </div>
+  </div>
+  <nav class="mobile-nav" data-mobile-nav aria-label="Mobile navigation">
+    <a href="overview.html">Overview</a>
+    <a href="index.html">Daily Run</a>
+    <a href="levels.html">Levels</a>
+    <a href="sequences.html" class="is-active">Sequences</a>
+    <a href="custom.html">Custom</a>
+    <a href="bank.html">Bank</a>
+  </nav>
+</header>
+<main class="shell">
+  <section class="identity">
+    <p class="kicker">Index</p>
+    <h1>Sequences</h1>
+    <p class="lede">Standalone runs and multi-day installs. The Daily Run holds the system; each sequence installs one specific file. Run any of them on its own.</p>
+    <div class="page-actions"><a href="index.html">Daily Run</a></div>
+  </section>
+
+  <section class="panel state-card">
+    <p class="panel-kicker">Sequence Map</p>
+    <h2>Sequences</h2>
+    <div class="state-table level-directory">
+      <div class="state-row"><a class="state-label state-label--link" href="avatar-override.html">Avatar Override / Identity Reinstall</a><a class="utility-link utility-link--open" href="avatar-override.html" aria-label="Open Avatar Override">Open</a></div>
+      <div class="state-row"><a class="state-label state-label--link" href="wormhole.html">Wormhole / 14-Day Identity Install</a><a class="utility-link utility-link--open" href="wormhole.html" aria-label="Open Wormhole">Open</a></div>
+      <div class="state-row"><a class="state-label state-label--link" href="age-reversal.html">Age Reversal / Five-Level Reversal</a><a class="utility-link utility-link--open" href="age-reversal.html" aria-label="Open Age Reversal">Open</a></div>
+    </div>
+  </section>
+
+  <section class="reference-section">
+    <p class="panel-kicker">How these run</p>
+    <h2>Standalone Installs</h2>
+    <div class="ref-block">
+      <p>A sequence is a self-contained run that installs one file and seals it. Some are a single pass; some run over days or levels. Run them apart from the Daily Run, or fold one in when the moment calls for it. New sequences are added here one at a time.</p>
+    </div>
+    <div class="ref-block">
+      <h3>Current Sequences</h3>
+      <div class="flat-list">
+        <div class="flat-row"><strong>Avatar Override</strong><span>One-pass identity reinstall — deactivate, install, calibrate, code, lock.</span></div>
+        <div class="flat-row"><strong>Wormhole</strong><span>Fourteen days. Synchronized identity install, entry to seal.</span></div>
+        <div class="flat-row"><strong>Age Reversal</strong><span>Five levels. Identity-layer reversal, run in order.</span></div>
+      </div>
+    </div>
+  </section>
+</main>
+<footer class="footer">The Protocol</footer>
+<script src="wormhole-lab.js"></script>
+</body>
+</html>
